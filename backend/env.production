# Production Environment Configuration
APP_ENV=production
NODE_ENV=production
PORT=5000

# MongoDB Configuration - Production Database
MONGO_URI=mongodb+srv://prod_user:prod_password@cluster0.rdgxy4m.mongodb.net/prod_db?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
JWT_SECRET=prod-jwt-secret-key-change-in-production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://production-frontend-url.vercel.app

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=prod-email@gmail.com
EMAIL_PASS=prod-app-password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=12

# Google OAuth Configuration
GOOGLE_CLIENT_ID=prod-google-client-id
GOOGLE_CLIENT_SECRET=prod-google-client-secret
GOOGLE_REDIRECT_URI=https://production-frontend-url.vercel.app
